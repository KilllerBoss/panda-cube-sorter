<!--
  panda-cube-sorter: scene template
  Panda-class 7-DOF arm (Franka-like joint convention & lengths, simplified geometry),
  parallel gripper (tendon-coupled), table, 4 colored sorting zones, colored cubes.
  The <!--CUBES--> marker is replaced by scene/compile_scene.py with N cube bodies.
  Final scenes are compiled to binary .mjb (no XML parsing at app startup).
-->
<mujoco model="panda_cube_sorter">
  <compiler angle="radian" autolimits="true" boundmass="0.01" boundinertia="1e-5"/>

  <option timestep="0.002" integrator="implicitfast" cone="pyramidal"
          solver="Newton" iterations="30" tolerance="1e-8"
          impratio="5" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.2" armature="0.05" frictionloss="0.15"/>
    <geom solref="0.008 1" solimp="0.95 0.99 0.001" friction="0.6 0.02 0.001" margin="0.0005"/>
    <default class="arm">
      <geom type="capsule" density="900" condim="3"
            contype="1" conaffinity="2"/>
      <joint damping="0.25" armature="0.05" frictionloss="0.2"/>
    </default>
    <default class="finger">
      <geom type="box" density="4000" friction="2.5 0.02 0.001" solref="0.010 1" solimp="0.95 0.99 0.001"
            contype="4" conaffinity="8"/>
      <joint type="slide" damping="60" armature="0.002" frictionloss="0.4"/>
    </default>
    <default class="cube">
      <geom type="box" size="0.025 0.025 0.025" mass="0.08" contype="1" conaffinity="7"
            friction="0.75 0.02 0.002" solref="0.006 1" solimp="0.96 0.995 0.0005"/>
    </default>
    <default class="zone">
      <geom type="box" contype="0" conaffinity="0" density="0"/>
    </default>
  </default>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.55 0.55 0.55" specular="0.15 0.15 0.15"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0.10 0.11 0.13" rgb2="0.10 0.11 0.13" width="32" height="32"/>
    <material name="mat_floor" rgba="0.22 0.23 0.25 1" specular="0.1" shininess="0.2"/>
    <material name="mat_table" rgba="0.45 0.38 0.30 1" specular="0.15" shininess="0.3"/>
    <material name="mat_arm"   rgba="0.85 0.85 0.87 1" specular="0.4" shininess="0.6"/>
    <material name="mat_link2" rgba="0.95 0.55 0.10 1" specular="0.4" shininess="0.6"/>
    <material name="mat_hand"  rgba="0.12 0.12 0.13 1" specular="0.3" shininess="0.5"/>
  </asset>

  <worldbody>
    <light name="top"    pos="0.55 0.0 1.60" dir="0 0 -1" diffuse="0.75 0.75 0.75" specular="0.2 0.2 0.2" castshadow="false"/>
    <light name="fill"   pos="0.2 -0.8 1.20" dir="0.35 0.6 -1" diffuse="0.30 0.30 0.32" castshadow="false"/>
    <geom name="floor" type="plane" size="4 4 0.05" material="mat_floor"/>

    <!-- ============ Panda-class arm (base at origin, front = +x) ============ -->
    <body name="link0" pos="0 0 0">
      <geom name="l0_base" class="arm"  type="cylinder" size="0.055 0.045" pos="0 0 0.045" material="mat_arm"/>
      <geom name="l0_disc" class="arm"  type="cylinder" size="0.070 0.012" pos="0 0 0.012" material="mat_hand"/>
      <body name="link1" pos="0 0 0.333">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-2.8973 2.8973"/>
        <geom name="l1" class="arm" type="capsule" fromto="0 0 0.02 0 0 0.10" size="0.052" material="mat_arm"/>
        <body name="link2" pos="0 0 0">
