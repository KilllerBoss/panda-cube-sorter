                        <geom name="finger_r_g" size="0.042 0.006 0.011" pos="0.042 0 0" class="finger" material="mat_hand"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

